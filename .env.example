# Copier ce fichier vers .env pour adapter l'API. Aucune valeur n'est un secret.

# Nombre maximal de requêtes par client sur /predict
CARDIO_RATE_LIMIT=30 per minute

# Stockage des compteurs. Avec plusieurs processus, utiliser un stockage partagé (Redis).
CARDIO_RATE_LIMIT_STORAGE=memory://

# Taille maximale d'une requête, en octets
CARDIO_MAX_CONTENT_LENGTH=4096

# Nombre de proxys de confiance devant l'API (1 derrière Nginx, 0 sans proxy)
CARDIO_TRUSTED_PROXIES=0

# Origines navigateur autorisées, séparées par des virgules.
# Vide en production : une application mobile native n'en a pas besoin.
CARDIO_CORS_ORIGINS=
